{
  "name": "@blogLsp/client",
  "displayName": "Blog Markdown LSP",
  "description": "Markdown editing assistant with LLM completions",
  "version": "0.1.0",
  "private": true,
  "author": "hskksk",
  "publisher": "hskksk",
	"repository": {
		"type": "git",
		"url": "https://github.com/hskksk/blogLsp"
	},
  "engines": {
		"vscode": "^1.99.0"
  },
  "dependencies": {
		"glob": "^11.0.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
		"@types/vscode": "^1.99.0",
		"@vscode/test-electron": "^2.3.9"
  },
  "contributes": {
    "configuration": {
      "title": "Blog LSP",
      "properties": {
        "blogLsp.stylePrompt": {
          "type": "string",
          "markdownDescription": "Optional multi-line style guide prompt to steer writing style.",
          "default": "",
          "scope": "window"
        }
      }
    }
  }
}